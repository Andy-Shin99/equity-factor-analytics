# Copy to .env.local and fill in. Never commit .env.local.
# Project Settings -> API in the Supabase dashboard.

# Exposed to the browser. Safe to publish — reads are constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_ and never
# import the admin client from a Client Component.
# Required by the price/factor collection routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret guarding /api/factors/backfill, which writes with the service
# role. Vercel Cron sends it automatically as `Authorization: Bearer <value>`.
# The route fails closed when this is unset, so leaving it blank disables the
# endpoint rather than exposing it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
